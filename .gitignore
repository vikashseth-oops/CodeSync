# ==============================================================================
# CodeSync - Root .gitignore
# Real-Time Collaborative Code Editor & Workspace
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Production & Build Artifacts
dist/
dist-ssr/
build/
Frontend/dist/
Backend/public/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Files
.cache/
.eslintcache
.vite/
.turbo/
*.tmp
*.temp

# Coverage & Testing
coverage/
*.lcov
.nyc_output

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker / Local Overrides
docker-compose.override.yml